# ---------------------------------------------------------------------------
# Publication safety comes first in this file, because the project's thesis is
# that measurements are untrustworthy when you cannot see how they were made.
# Counts, rates, figures and the record are publishable. Corpus text is not.
# Design reused from safety-eval-pipeline (DOI 10.5281/zenodo.22182741).
# ---------------------------------------------------------------------------

# Private research planning. Local only, never tracked.
.research-plan/

# Real corpus data. Only counts and hashes derived from these may be committed.
data/wikitactics/
data/german-collusion-wiki/
data/mythos-5-incident-transcript/
data/inspect_logs/

# Inspect logs are not committed at all, matching safety-eval-pipeline's rule.
logs/
*.eval

# Windows "mark of the web" streams that WSL surfaces as real files.
*:Zone.Identifier

# Virtual environments
.venv/
venv/
env/

# Secrets
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
coverage.xml

# Model checkpoints pulled for NliDetector; cached, never vendored.
.cache/
models/

# OS / IDE
.DS_Store
Thumbs.db
.vscode/
.idea/
.ipynb_checkpoints/

# Real Inspect run logs supplied 2026-09-12 (three registered benchmarks).
data/inspect-runs/

# collusion.wiki frozen export. Counts publishable, revision text is not.
data/german-collusion-wiki/

# Reasoning-model emission runs (OpenRouter), 2026-09-12. Counts only are committed.
data/inspect-runs-reasoning/

# The METR source PDF is a published report, not our data. Not redistributed.
data/METR/
# Annotation labels only - no corpus text. Committed with the results.
!results/annotations/

# Built artefact for the human coder; regenerate with scripts/make_coder_bundle.sh
coder-bundle/
coder-bundle*.zip

# Long-horizon agentic arm logs.
data/inspect-runs-agentic/

# Long-horizon CTF arm logs (Docker sandbox).
data/inspect-runs-ctf/

# Warm-up rounds are not data.
results/annotations/*__practice.json
results/annotations/*__smoke*.json

# Third long-horizon family (OS tasks, Docker).
data/inspect-runs-osbench/

# Follow-up arms R1-R3 staging (moved into the family corpus dirs when complete).
data/inspect-runs-followup/

# Monitor experiment staging (AgentHarm harmful; agent + monitor outputs).
data/monitor-experiment/
data/monitor-smoke/

# SWE-bench long-horizon staging.
data/inspect-runs-swebench/
data/inspect-runs-swebench-smoke/

# Out-of-focus experiments relocated from the paper focus (local only).
.other-experiments/
